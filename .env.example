# ══════════════════════════════════════════════════════════════════
#  MonitorPro — Template de configuration d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs réelles.
#  Le fichier .env NE doit JAMAIS être commité sur Git.
#  Ce fichier .env.example PEUT être commité (pas de secrets).
# ══════════════════════════════════════════════════════════════════

# Clé secrète Flask (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Environnement : development | production | testing
FLASK_ENV=development

# Port d'écoute
FLASK_PORT=5000

# Hôte d'écoute
FLASK_HOST=0.0.0.0
